# Listen address. Default 127.0.0.1 keeps the API off the LAN.
# Use 0.0.0.0 only inside a container or when you intentionally expose the port.
HOST=127.0.0.1

# HTTP port for the bridge dashboard and API
PORT=4000

# Optional override for the Antigravity agentapi binary.
# If unset, the server tries ~/.gemini/antigravity-ide/bin/agentapi then `which agentapi`.
# AGENTAPI_PATH=/Users/you/.gemini/antigravity-ide/bin/agentapi
